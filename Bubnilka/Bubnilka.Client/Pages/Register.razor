@page "/register"
@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<h2>Регистрация</h2>

<EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    
    <div class="form-group">
        <label>Имя</label>
        <InputText @bind-Value="registerModel.DisplayName" class="form-control" placeholder="Как к вам обращаться?" />
    </div>
    
    <div class="form-group">
        <label>Email</label>
        <InputText @bind-Value="registerModel.Email" class="form-control" placeholder="your@email.com" />
    </div>
    
    <div class="form-group">
        <label>Пароль</label>
        <InputText @bind-Value="registerModel.Password" type="password" class="form-control" placeholder="******" />
    </div>
    
    <button type="submit" class="btn btn-primary" disabled="@isLoading">
        @if (isLoading)
        {
            <span>Регистрация...</span>
        }
        else
        {
            <span>Создать аккаунт</span>
        }
    </button>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">@errorMessage</div>
    }
</EditForm>

<p class="auth-link">
    Уже есть аккаунт? <a href="/login">Войти</a>
</p>

@code {
    private RegisterRequest registerModel = new();
    private bool isLoading = false;
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = "";

        var result = await AuthService.Register(registerModel.DisplayName, registerModel.Email, registerModel.Password);

        if (result.Success)
        {
            Navigation.NavigateTo("/chats");
        }
        else
        {
            errorMessage = result.Error ?? "Ошибка регистрации";
        }

        isLoading = false;
        StateHasChanged();
    }
}
